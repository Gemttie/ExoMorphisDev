config_version=5

[application]

config/name="Exo Morphis"
run/main_scene="uid://dwwfgyf5tylbc"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

FreezeFrameControl="*res://data/scripts/freeze_frame_control.gd"
SoundManager="*res://data/scripts/sound_manager.gd"
SoundControl="*res://data/scripts/sound_control.gd"
CameraControl="*res://data/scripts/camera_control.gd"
PauseManager="*res://data/scripts/pause_manager.gd"

